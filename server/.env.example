# =====================================================
# Pipeline Labs Backend Server Environment Variables
# =====================================================

# Supabase Configuration (same as frontend .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key  # Optional: for admin operations

# Server Configuration
SERVER_PORT=3001
CLIENT_URL=http://localhost:8080  # Frontend Vite dev server URL

# AI API Keys (optional - for AI-enhanced planning)
GEMINI_API_KEY=your-gemini-key  # For AI training plan generation

# Note: Cloud provider credentials are stored per-user in the database,
# not in environment variables. Users connect their own AWS/Azure/GCP/RunPod accounts.
